<?xml version="1.0"?>
<package format="3">
  <name>openarm_interfaces</name>
  <version>0.0.0</version>
  <description>Custom ROS 2 action interfaces for OpenArm tasks.</description>

  <maintainer email="127087226+yeshezhi@users.noreply.github.com">yeshezhi</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>

  <depend>geometry_msgs</depend>

  <exec_depend>rosidl_default_runtime</exec_depend>

  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <!-- 声明这是一个 ament_cmake 构建类型的 ROS 2 包。 -->
    <build_type>ament_cmake</build_type>
  </export>
</package>